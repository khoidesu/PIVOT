# Cấu hình LOCAL cho backend LOGECTION. Sao chép thành backend/.env rồi điền khoá (backend/.env đã nằm trong .gitignore).
# KHÔNG commit khoá, KHÔNG dán khoá vào chat/Zalo/Slack. Lộ khoá → vào AI Studio xoá khoá cũ, tạo khoá mới.

# --- Gemini (nhập liệu từ tin nhắn, ảnh, PDF scan) ---------------------------------------------
# Lấy khoá tại https://aistudio.google.com/apikey (đăng nhập tài khoản Google → Create API key).
PIVOT_GEMINI_API_KEY=
# rule = chỉ bộ luật (không gọi mạng) · hybrid = luật trước, Gemini bổ sung trường còn thiếu (giá/tên khách được che trước khi gửi)
PIVOT_INTAKE_EXTRACTOR=hybrid
# Mô hình cho tin nhắn / PDF có chữ (nhanh, rẻ). Bỏ dấu # để đổi; giữ nguyên = mặc định của mã.
# PIVOT_GEMINI_MODEL=gemini-3.1-flash-lite
# Mô hình đọc ẢNH và PDF scan. Có thể dùng bản Pro (đọc chữ viết tay, ảnh chụp lệch tốt hơn, chậm và tốn hơn).
# Bỏ dấu # và điền tên mô hình để dùng; giữ nguyên = dùng PIVOT_GEMINI_MODEL. Xem danh sách mô hình khoá của bạn dùng được: demo_docs/ocr/README.md (mục "Khoá Gemini").
# PIVOT_GEMINI_VISION_MODEL=gemini-3.5-flash
# Dự phòng khi mô hình chính quá tải (503) hoặc hết lượt (429):
# PIVOT_GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.1-flash-lite

# --- Giới hạn lượt đọc ảnh (mặc định 3 ảnh/người/ngày, 2/phút — quá ít để chạy hết bộ demo) ------
PIVOT_LLM_IMAGE_PER_USER_DAY=30
PIVOT_LLM_IMAGE_PER_USER_MINUTE=6
# Theo IP + toàn hệ thống mỗi phút (mặc định 20/IP/ngày, 6/IP/phút, 10/phút; = 0 là tắt). Máy local một người dùng: nới hoặc tắt.
# PIVOT_LLM_IMAGE_PER_IP_DAY=20
# Chỉ đặt true khi chạy SAU proxy (Render): lấy IP từ phần tử cuối của X-Forwarded-For
# PIVOT_TRUST_PROXY=false
