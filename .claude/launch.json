{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "cd backend && exec .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port ${PORT:-8000}"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "cd frontend && exec npm run dev"],
      "port": 5173
    }
  ]
}
